# ============================================================
# OwnerLens local development configuration
# ============================================================

# SEC — identify your application and an administrative contact to the SEC.
# Required for live Company Facts retrieval.
OWNER_LENS_SEC_USER_AGENT=OwnerLens your-email@example.com

# Local persistence (Slice 4A). `data/` is local runtime state and is gitignored;
# raw SEC payloads are stored as data/raw/sec/company_facts/<CIK>/<content-hash>.json.
OWNER_LENS_DB_PATH=data/ownerlens.db
OWNER_LENS_RAW_DATA_PATH=data/raw/sec/company_facts