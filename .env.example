# ============================================================
# OwnerLens local development configuration
# ============================================================

# SEC
OWNER_LENS_SEC_USER_AGENT=OwnerLens your-email@example.com

# Azure
OWNER_LENS_AZURE_SUBSCRIPTION_ID=
OWNER_LENS_AZURE_RESOURCE_GROUP=rg-ownerlens-dev

# Blob Storage
OWNER_LENS_AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
OWNER_LENS_RAW_CONTAINER=sec-company-facts

# PostgreSQL Flexible Server
OWNER_LENS_PG_HOST=<server>.postgres.database.azure.com
OWNER_LENS_PG_DATABASE=ownerlens
OWNER_LENS_PG_USER=<entra-user-or-role>
OWNER_LENS_PG_SSLMODE=require

# Optional fallback only if PostgreSQL password auth is enabled
OWNER_LENS_PG_PASSWORD=

# Key Vault — only once actually introduced
OWNER_LENS_KEY_VAULT_URL=